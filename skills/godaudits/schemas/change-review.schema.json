{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hannsxpeter/godaudits/schemas/change-review.schema.json",
  "title": "godaudits change safety review",
  "type": "object",
  "required": [
    "schema_version",
    "review",
    "change",
    "impact_leads",
    "affected_domains",
    "affected_checks",
    "safety_facts",
    "proofs",
    "risks",
    "cleared",
    "before_merge",
    "merge_gate"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "review": {
      "type": "object",
      "required": ["repository", "created", "updated", "base", "head", "diff_sha256", "capabilities", "limitations"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "format": "date" },
        "updated": { "type": "string", "format": "date" },
        "base": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["static", "sandbox", "connected"] },
          "uniqueItems": true,
          "contains": { "const": "static" }
        },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["summary", "languages", "files"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["status", "path", "additions", "deletions", "symbols"],
            "properties": {
              "status": { "enum": ["added", "copied", "deleted", "modified", "renamed", "type-changed", "changed"] },
              "path": { "type": "string", "minLength": 1 },
              "previous_path": { "type": "string", "minLength": 1 },
              "additions": { "type": ["integer", "null"], "minimum": 0 },
              "deletions": { "type": ["integer", "null"], "minimum": 0 },
              "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "impact_leads": {
      "type": "array",
      "items": { "$ref": "#/$defs/impactLead" }
    },
    "affected_domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "affected_checks": { "type": "array", "items": { "type": "string", "pattern": "^A-[A-Z]+-[0-9]+$" }, "uniqueItems": true },
    "safety_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/safetyFact" }
    },
    "proofs": { "type": "array", "items": { "$ref": "#/$defs/proof" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "cleared": { "type": "array", "items": { "$ref": "#/$defs/cleared" } },
    "before_merge": {
      "type": "object",
      "required": ["command", "status", "proof_ids"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["unproven", "passed", "failed"] },
        "proof_ids": { "$ref": "#/$defs/proofReferences" }
      },
      "additionalProperties": false
    },
    "merge_gate": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["unproven", "pass", "blocked"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringSet": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "proofReferences": { "type": "array", "items": { "type": "string", "pattern": "^P-[0-9]{3,}$" }, "uniqueItems": true },
    "impactLead": {
      "type": "object",
      "required": ["id", "kind", "summary", "basis", "source_paths", "downstream_paths", "symbols", "domains", "checks"],
      "properties": {
        "id": { "type": "string", "pattern": "^BRL-[0-9]{3,}$" },
        "kind": {
          "enum": [
            "direct-reference",
            "public-contract",
            "database-schema",
            "dependency-version",
            "configuration-flag",
            "serialization-wire",
            "cross-language",
            "async-lifecycle",
            "cache-invalidation",
            "generated-artifact",
            "public-entry-point",
            "audit-finding"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 400 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 600 },
        "source_paths": { "$ref": "#/$defs/stringSet" },
        "downstream_paths": { "$ref": "#/$defs/stringSet" },
        "symbols": { "$ref": "#/$defs/stringSet" },
        "domains": { "$ref": "#/$defs/stringSet" },
        "checks": { "type": "array", "items": { "type": "string", "pattern": "^A-[A-Z]+-[0-9]+$" }, "uniqueItems": true },
        "finding_ids": { "type": "array", "items": { "type": "string", "pattern": "^F-[A-Z]+-[0-9]+$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "safetyFact": {
      "type": "object",
      "required": ["id", "claim", "status", "proof_level", "proof_kind", "proof_ids", "stopped_because"],
      "properties": {
        "id": { "type": "string", "pattern": "^SF-[12]$" },
        "claim": { "type": "string", "minLength": 1, "maxLength": 400 },
        "status": { "enum": ["unproven", "proven", "refuted"] },
        "proof_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "proof_kind": { "enum": ["assertion", "citation", "failure-path", "executable", "running-app"] },
        "proof_ids": { "$ref": "#/$defs/proofReferences" },
        "stopped_because": { "type": ["string", "null"], "minLength": 1, "maxLength": 400 }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["id", "level", "kind", "redacted"],
      "properties": {
        "id": { "type": "string", "pattern": "^P-[0-9]{3,}$" },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "kind": { "enum": ["assertion", "citation", "failure-path", "executable", "running-app"] },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "isolation": { "type": "string", "minLength": 1 },
        "capability": { "enum": ["sandbox", "connected"] },
        "authorized_by": { "type": "string", "minLength": 1 },
        "redacted": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "enum": [2, 3] } }, "required": ["level"] },
          "then": { "required": ["path", "line", "quote", "sha256"] }
        },
        {
          "if": { "properties": { "level": { "const": 3 } }, "required": ["level"] },
          "then": { "required": ["steps"] }
        },
        {
          "if": { "properties": { "level": { "enum": [4, 5] } }, "required": ["level"] },
          "then": { "required": ["tool", "tool_version", "command", "result", "environment", "isolation", "capability", "authorized_by"] }
        }
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["id", "title", "mechanism", "likelihood", "consequence", "verify", "status", "proof_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^BR-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "likelihood": { "enum": ["rare", "unlikely", "possible", "likely", "almost-certain"] },
        "consequence": { "enum": ["Critical", "High", "Medium", "Low"] },
        "verify": { "type": "string", "minLength": 1 },
        "status": { "const": "open" },
        "proof_ids": { "$ref": "#/$defs/proofReferences" }
      },
      "additionalProperties": false
    },
    "cleared": {
      "type": "object",
      "required": ["id", "title", "rationale", "invalidated_by", "proof_level", "proof_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^CL-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "invalidated_by": { "type": "string", "minLength": 1 },
        "proof_level": { "type": "integer", "minimum": 2, "maximum": 5 },
        "proof_ids": { "$ref": "#/$defs/proofReferences" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

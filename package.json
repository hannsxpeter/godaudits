{
  "name": "@hxp-tools/godaudits",
  "version": "2.20.0",
  "description": "Evidence-first codebase auditing for AI coding agents. Eighteen domains, 437 checks, computed scores, MDX repair plans, and proof-gated change safety.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "audit",
    "blast-radius",
    "change-review",
    "code-audit",
    "security-audit",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "technical-debt",
    "mdx",
    "remediation",
    "code-quality"
  ],
  "homepage": "https://github.com/hannsxpeter/godaudits#readme",
  "bugs": {
    "url": "https://github.com/hannsxpeter/godaudits/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannsxpeter/godaudits.git"
  },
  "license": "MIT",
  "author": "hannsxpeter",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "assets",
    "benchmarks",
    "evals",
    "requirements",
    "test",
    "skills",
    "install.sh",
    "scripts",
    "PROMPT.md",
    "PROMPT.full.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "ACCURACY.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "bin": {
    "godaudits": "bin/godaudits.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "benchmark": "node bin/godaudits.js benchmark",
    "eval:suites": "node scripts/eval.js",
    "catalog": "node scripts/build-catalog.js",
    "catalog:check": "node scripts/build-catalog.js --check",
    "check-map": "node scripts/build-check-map.js",
    "check-map:check": "node scripts/build-check-map.js --check",
    "build:prompt": "bash scripts/build-prompt.sh",
    "prompt:check": "bash scripts/build-prompt.sh --check",
    "version:sync": "node scripts/version-sync.js",
    "version:check": "node scripts/version-sync.js --check",
    "release:prepare": "node scripts/release-prepare.js",
    "lint": "bash scripts/lint.sh --all --verbose",
    "check": "npm run version:check && npm run check-map:check && npm run corpus:check && npm run accuracy:check && npm run dogfood:check && npm run test && npm run benchmark && npm run test:detectors && npm run eval:suites && npm run lint",
    "release:check": "bash scripts/release-check.sh",
    "install:skill": "sh install.sh",
    "prepack": "npm run check",
    "postpack": "echo 'Install with: npx @hxp-tools/godaudits@latest doctor, or npx skills add hannsxpeter/godaudits'",
    "test:detectors": "node scripts/detector-gate.js",
    "accuracy:check": "node scripts/accuracy-check.js",
    "accuracy:run": "node scripts/run-paired-accuracy.js",
    "accuracy:regrade": "node scripts/regrade-accuracy.js",
    "dogfood:run": "node scripts/run-dogfood-audit.js",
    "dogfood:check": "node scripts/dogfood-check.js",
    "corpus": "node benchmarks/build-detector-corpus.js",
    "corpus:check": "node benchmarks/build-detector-corpus.js --check"
  }
}
